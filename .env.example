
# Các biến môi trường sẽ được sử dụng ở những giai đoạn sau.
# Không đặt secret thật vào file này.

JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600

MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lab-minio-user
MINIO_SECRET_KEY=replace-with-a-random-minio-secret
MINIO_BUCKET=avatars
PRESIGNED_URL_EXPIRE_SECONDS=300

GATEWAY_RATE_LIMIT=10r/s
GATEWAY_RATE_BURST=20
